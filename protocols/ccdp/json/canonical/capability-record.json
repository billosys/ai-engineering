    "cacheable": false,
    "max_input_size": 1048576,

    "tags": ["formal-methods", "smt", "sat"],
    "description": "Z3 SMT solver for propositional and first-order logic",
    "registered_at": "2026-07-15T10:00:00Z",
    "updated_at": "2026-08-01T14:00:00Z",

    "metadata": {
