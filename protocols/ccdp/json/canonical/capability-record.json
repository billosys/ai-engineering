    "cost_hints": {
      "estimated_latency_ms": { "p50": 500, "p95": 5000, "p99": 30000 },
      "estimated_cost_per_request": { "monetary_units": "0.001", "monetary_unit": "USD" },
      "token_cost": null,
      "compute_intensive": true
    },

    "provenance_capabilities": {
